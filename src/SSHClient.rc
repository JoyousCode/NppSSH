#include "Resource.h"
#include <windows.h>

//////////////////////////////////////////////////////////////////////////
// 图标资源（规范命名 + 正确相对路径）
//////////////////////////////////////////////////////////////////////////
IDI_ICON_CONNECT        ICON    "res/connect.ico"
IDI_ICON_DISCONNECT     ICON    "res/disconnect.ico"
IDI_ICON_NPPSSH        ICON    "res/nppssh.ico"
IDI_EYE_HIDE        ICON    "res/EyeHide.ico"
IDI_EYE_SHOW        ICON    "res/EyeShow.ico"
IDI_ICON_PUTTY        ICON    "res/putty.ico"
IDI_ICON_SELECT        ICON    "res/selectfile.ico"
IDI_ICON_CLOSE        ICON    "res/close.ico"
IDI_ICON_WINTOP        ICON    "res/top.ico"
IDI_ICON_CLOSEWINTOP        ICON    "res/closetop.ico"
//////////////////////////////////////////////////////////////////////////
// Notepad++ 停靠面板（官方标准样式，无警告）
//////////////////////////////////////////////////////////////////////////
IDD_SSH_PANEL DIALOGEX 0, 0, 400, 260
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD | WS_BORDER
CAPTION "NppSSH Terminal"
FONT 9, "Microsoft Sans Serif", 400, 0, 0x01
BEGIN

END

//////////////////////////////////////////////////////////////////////////
// SSH 登录对话框
//////////////////////////////////////////////////////////////////////////
IDD_SSH_LOGIN DIALOGEX 0, 0, 280, 140
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
EXSTYLE WS_EX_APPWINDOW
CAPTION "SSH 登录"
FONT 12, "Microsoft YaHei UI", 400, 0, 0x01
BEGIN
    // 主机行（标签+输入框精准对齐，间距舒适）
    LTEXT           "主机:", -1, 28, 12, 20, 12, SS_CENTERIMAGE
    EDITTEXT        IDC_HOST,  50, 12, 200, 12, ES_AUTOHSCROLL | WS_TABSTOP | ES_AUTOVSCROLL

    // 端口行
    LTEXT           "端口:", -1, 28, 36, 20, 12, SS_CENTERIMAGE
    EDITTEXT        IDC_PORT,  50, 36, 200, 12, ES_AUTOHSCROLL | WS_TABSTOP

    // 用户行
    LTEXT           "用户:", -1, 28, 60, 20, 12, SS_CENTERIMAGE
    EDITTEXT        IDC_USER,  50, 60, 200, 12, ES_AUTOHSCROLL | WS_TABSTOP | ES_AUTOVSCROLL

    // 密码行
    LTEXT           "密码:", -1, 28, 84, 20, 12, SS_CENTERIMAGE
    EDITTEXT        IDC_PASS,  50, 84, 185, 12, ES_AUTOHSCROLL | ES_PASSWORD | WS_TABSTOP | ES_AUTOVSCROLL
    CONTROL         "", IDC_BTN_EYE, "BUTTON", WS_CHILD | WS_VISIBLE | BS_ICON, 235, 84, 15, 12

    // 按钮区
    PUSHBUTTON      "测试", IDC_BTN_TEST, 20, 110, 40, 15
    DEFPUSHBUTTON   "连接", IDC_BTN_CONNECT, 220, 110, 40, 15
END

//////////////////////////////////////////////////////////////////////////
// Putty 登录对话框
//////////////////////////////////////////////////////////////////////////
IDD_SSH_Putty_LOGIN DIALOGEX 0, 0, 256, 174
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
EXSTYLE WS_EX_APPWINDOW
CAPTION "Putty 登录"
FONT 12, "Microsoft YaHei UI", 400, 0, 0x01
BEGIN
// 主机行（标签+输入框精准对齐，间距舒适）
LTEXT           "主机:", -1, 46, 12, 20, 12, SS_CENTERIMAGE
// COMBOBOX        IDC_HOST, 70, 12, 140, 60, CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
COMBOBOX        IDC_HOST, 70, 12, 140, 60, CBS_DROPDOWN | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP

// 端口行
LTEXT           "端口:", -1, 46, 36, 20, 12, SS_CENTERIMAGE
EDITTEXT        IDC_PORT, 70, 36, 140, 12, ES_AUTOHSCROLL | WS_TABSTOP

// 用户行
LTEXT           "用户:", -1, 46, 60, 20, 12, SS_CENTERIMAGE
EDITTEXT        IDC_USER, 70, 60, 140, 12, ES_AUTOHSCROLL | WS_TABSTOP | ES_AUTOVSCROLL

// 密码行
LTEXT           "密码:", -1, 46, 84, 20, 12, SS_CENTERIMAGE
EDITTEXT        IDC_PASS, 70, 84, 125, 12, ES_AUTOHSCROLL | ES_PASSWORD | WS_TABSTOP | ES_AUTOVSCROLL
CONTROL         "", IDC_BTN_EYE, "BUTTON", WS_CHILD | WS_VISIBLE | BS_ICON, 195, 84, 15, 12

// 初始远程目录行
LTEXT           "初始远程目录:", -1, 20, 108, 46, 12, SS_CENTERIMAGE
EDITTEXT        IDC_DIRECTOR, 70, 108, 140, 12, ES_AUTOHSCROLL | WS_TABSTOP | ES_AUTOVSCROLL

CONTROL         "保存本次登录记录", IDC_CHK_SAVE_HIST, "BUTTON", BS_AUTOCHECKBOX | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 145, 128, 65, 14


// 按钮区
PUSHBUTTON      "取消登录", IDC_BTN_CONNECT, 36, 148, 40, 15
DEFPUSHBUTTON   "确认登录", IDC_BTN_SUBMIT, 180, 148, 40, 15
END

//////////////////////////////////////////////////////////////////////////
// 版本信息（规范、无编译警告、NPP 插件标准）
//////////////////////////////////////////////////////////////////////////
VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,0,1,0
PRODUCTVERSION  0,0,1,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG | VS_FF_PRIVATEBUILD
#else
FILEFLAGS       0
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName",      "NppSSH"
            VALUE "FileDescription",  "NppSSH Terminal Plugin"
            VALUE "FileVersion",      "0.0.1.0"
            VALUE "InternalName",     "NppSSH"
            VALUE "ProductName",      "NppSSH"
            VALUE "ProductVersion",   "0.0.1.0"
            VALUE "OriginalFilename", "NppSSH.dll"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END